// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?   @unique
  phoneNumber String
  gender      Gender
  address     String
  dateOfBirth DateTime?
  password    String?

  // Campus-specific details
  matricNumber String? @unique // For students only
  department   String?
  level        String? // e.g. "100", "200", "300", "400", "Postgraduate"
  faculty      String?

  // Other identifiers
  nationality      String?
  stateOfOrigin    String?
  emergencyContact String?

  // Layered church journey
  churchStatus   ChurchStatus    @default(VISITOR)
  membershipType MembershipType?
  workerType     WorkerType?

  role UserRole @default(MEMBER)

  accountStatus AccountStatus @default(ACTIVE)

  version Int @default(1)

  attendances          Attendance[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  primaryDepartmentId  String?
  primaryDepartment    Department?  @relation("UserPrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  departments          Department[] @relation("UserDepartments")
  headedDepartments    Department[] @relation("DepartmentHead")
  assistantDepartments Department[] @relation("DepartmentAssistant")

  createdInvoices  Invoice[]                      @relation("CreatedInvoices")
  paidInvoices     Invoice[]                      @relation("PaidInvoices")
  approvedInvoices Invoice[]                      @relation("ApprovedInvoices")
  recordedPayments InvoicePayment[]               @relation("RecordedPayments")
  recordedIncomes  SessionIncome[]                @relation("RecordedIncomes")
  passwordInvites  InviteToken[]                  @relation("UserInvites")
  createdInvites   InviteToken[]                  @relation("CreatedInvites")
  deptLateUpdates  ServiceDayDepartmentLateTime[] @relation("DeptLateUpdates")
  deptPositions    DepartmentPosition[]           @relation("UserDepartmentPositions")
}

model AttendanceSession {
  id               String           @id @default(cuid())
  serviceName      String
  date             DateTime?
  startedAt        DateTime         @default(now())
  endedAt          DateTime?
  serviceDayId     String?
  serviceDay       ServiceDay?      @relation(fields: [serviceDayId], references: [id], onDelete: SetNull)
  specialProgramId String?
  specialProgram   SpecialProgram?  @relation(fields: [specialProgramId], references: [id], onDelete: SetNull)
  services         SessionService[]
  attendees        Attendance[]
  createdAt        DateTime         @default(now())

  version Int @default(1)

  @@index([serviceDayId])
  @@index([specialProgramId])
}

model ServiceDay {
  id            String                         @id @default(cuid())
  name          String
  version       Int                            @default(1)
  weekday       Weekday
  services      ServiceDayService[]
  variations    ServiceDayVariation[]
  sessions      AttendanceSession[]
  deptLateTimes ServiceDayDepartmentLateTime[]
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
}

model ServiceDayVariation {
  id           String                       @id @default(cuid())
  serviceDayId String
  serviceDay   ServiceDay                   @relation(fields: [serviceDayId], references: [id], onDelete: Cascade)
  name         String
  version      Int                          @default(1)
  services     ServiceDayVariationService[]
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([serviceDayId, name])
  @@index([serviceDayId])
}

model ServiceDayVariationService {
  id             String              @id @default(cuid())
  variationId    String
  variation      ServiceDayVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  order          Int
  serviceTime    String // "HH:mm"
  preServiceTime String? // "HH:mm" or null
  closesAt       String? // "HH:mm" or null

  version Int @default(1)

  @@unique([variationId, order])
  @@index([variationId])
}

model ServiceDayDepartmentLateTime {
  id           String     @id @default(cuid())
  serviceDayId String
  serviceDay   ServiceDay @relation(fields: [serviceDayId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lateTime     String // "HH:mm"
  updatedById  String?
  updatedBy    User?      @relation("DeptLateUpdates", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  version      Int        @default(1)

  @@unique([serviceDayId, departmentId])
  @@index([serviceDayId])
  @@index([departmentId])
}

model ServiceDayService {
  id             String     @id @default(cuid())
  serviceDayId   String
  serviceDay     ServiceDay @relation(fields: [serviceDayId], references: [id], onDelete: Cascade)
  order          Int
  serviceTime    String // "HH:mm"
  preServiceTime String? // "HH:mm" or null
  closesAt       String? // "HH:mm" or null

  version Int @default(1)

  @@unique([serviceDayId, order])
  @@index([serviceDayId])
}

model SpecialProgram {
  id       String                  @id @default(cuid())
  name     String
  date     DateTime?
  services SpecialProgramService[]
  sessions AttendanceSession[]

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecialProgramService {
  id               String         @id @default(cuid())
  specialProgramId String
  specialProgram   SpecialProgram @relation(fields: [specialProgramId], references: [id], onDelete: Cascade)
  order            Int
  serviceTime      String // "HH:mm"
  preServiceTime   String? // "HH:mm" or null
  closesAt         String? // "HH:mm" or null

  version Int @default(1)

  @@unique([specialProgramId, order])
  @@index([specialProgramId])
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model SessionService {
  id             String            @id @default(cuid())
  sessionId      String
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order          Int
  serviceTime    DateTime
  preServiceTime DateTime?
  closesAt       DateTime?
  incomes        SessionIncome[]

  version Int @default(1)

  @@unique([sessionId, order])
  @@index([sessionId])
}

model SessionIncome {
  id               String         @id @default(cuid())
  sessionServiceId String
  sessionService   SessionService @relation(fields: [sessionServiceId], references: [id], onDelete: Cascade)
  category         IncomeCategory
  method           PaymentMethod
  amount           Decimal        @db.Decimal(12, 2)
  recordedById     String?
  recordedBy       User?          @relation("RecordedIncomes", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  version Int @default(1)

  @@unique([sessionServiceId, category, method])
  @@index([sessionServiceId])
}

enum IncomeCategory {
  TITHE
  OFFERING
  SPECIAL_DONATION
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model InviteToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserInvites", fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  createdById String?
  createdBy   User?     @relation("CreatedInvites", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Attendance {
  id           String            @id @default(cuid())
  sessionId    String
  userId       String
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  markedAt     DateTime          @default(now())
  serviceOrder Int               @default(1)

  version Int @default(1)

  @@index([sessionId, serviceOrder])
}

model Department {
  id                     String  @id @default(uuid())
  name                   String  @unique
  description            String?
  headId                 String?
  head                   User?   @relation("DepartmentHead", fields: [headId], references: [id])
  members                User[]  @relation("UserDepartments")
  assistantHeads         User[]  @relation("DepartmentAssistant")
  primaryDepartmentUsers User[]  @relation("UserPrimaryDepartment")

  version Int @default(1)

  lateTimes ServiceDayDepartmentLateTime[]
  positions DepartmentPosition[]
}

model Position {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  permissions PositionPermission[]
  assignments DepartmentPosition[]

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  description String?

  version Int @default(1)

  positions PositionPermission[]
  createdAt DateTime             @default(now())
}

model PositionPermission {
  positionId   String
  permissionId String
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  version Int @default(1)

  @@id([positionId, permissionId])
  @@index([permissionId])
}

model DepartmentPosition {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  positionId   String
  user         User       @relation("UserDepartmentPositions", fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  version Int @default(1)

  @@unique([userId, departmentId, positionId])
  @@index([departmentId])
  @@index([userId])
}

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  title       String
  description String?
  currency    String  @default("NGN")

  status InvoiceStatus @default(CREATED)

  totalAmount Float @default(0)

  createdById    String
  markedPaidById String?
  approvedById   String?

  receiptUrl String?

  paidAt     DateTime?
  approvedAt DateTime?

  createdBy    User? @relation("CreatedInvoices", fields: [createdById], references: [id])
  markedPaidBy User? @relation("PaidInvoices", fields: [markedPaidById], references: [id])
  approvedBy   User? @relation("ApprovedInvoices", fields: [approvedById], references: [id])

  version Int @default(1)

  departments InvoiceDepartment[]
  payments    InvoicePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceDepartment {
  id String @id @default(uuid())

  invoiceId      String
  departmentName String

  bankName      String
  accountName   String
  accountNumber String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  items InvoiceItem[]

  createdAt DateTime @default(now())

  version Int @default(1)

  @@index([invoiceId])
}

model InvoiceItem {
  id          String @id @default(uuid())
  description String
  quantity    Int    @default(1)
  unitPrice   Float
  totalPrice  Float

  invoiceDepartmentId String
  invoiceDepartment   InvoiceDepartment @relation(fields: [invoiceDepartmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  version   Int      @default(1)
}

enum Gender {
  MALE
  FEMALE
}

enum ChurchStatus {
  FIRST_TIMER
  VISITOR
  MEMBER
}

enum MembershipType {
  NON_WORKER
  WORKER
}

enum WorkerType {
  REGULAR
  EXECUTIVE
}

enum UserRole {
  MEMBER
  WORKER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

model InvoicePayment {
  id           String   @id @default(uuid())
  invoiceId    String
  amount       Float
  receiptUrl   String?
  note         String?
  recordedById String
  paidAt       DateTime @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("RecordedPayments", fields: [recordedById], references: [id])

  version Int @default(1)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum InvoiceStatus {
  CREATED
  APPROVED
  PARTIALLY_PAID
  PAID
}

model ChurchSettings {
  id          String  @id @default("singleton")
  name        String
  email       String  @default("")
  phoneNumber String  @default("")
  logoUrl     String?
  address     String?

  version Int @default(1)

  updatedAt DateTime @updatedAt
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  CONFLICT
}

enum SyncDirection {
  PUSH
  PULL
}

model SyncChange {
  id               String @id @default(uuid())
  sourceDatabaseId String

  entity   String
  entityId String

  operation SyncOperation

  entityVersion Int

  payload Json?

  sequence BigInt

  status SyncStatus @default(PENDING)

  createdAt DateTime  @default(now())
  syncedAt  DateTime?

  @@unique([sourceDatabaseId, sequence])
  @@index([sourceDatabaseId, status])
  @@index([entity, entityId])
  @@index([createdAt])
}

model SyncConflict {
  id String @id @default(uuid())

  entity   String
  entityId String

  localVersion  Int
  remoteVersion Int

  localPayload  Json
  remotePayload Json

  sourceDatabaseId String
  remoteDatabaseId String

  resolved Boolean @default(false)

  resolution String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([entity, entityId])
  @@index([resolved])
}

model SyncState {
  id String @id @default(uuid())

  localDatabaseId  String
  remoteDatabaseId String

  lastPushedSequence BigInt @default(0)

  lastPulledSequence BigInt @default(0)

  lastSyncAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([localDatabaseId, remoteDatabaseId])
}

model SyncDatabase {
  id String @id @default(uuid())

  databaseId String @unique

  name String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SyncSequence {
  id Int @id @default(1)

  current BigInt @default(0)
}
