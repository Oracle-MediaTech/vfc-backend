{
  "name": "oracle-api",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "node esbuild.config.js && npm run obfuscate && npm run copy-templates && npm run copy-certs",
    "obfuscate": "node scripts/obfuscate.js",
    "copy-templates": "copyfiles -u 1 src/modules/email/templates/*.handlebars dist/",
    "copy-certs": "copyfiles -u 1 src/certs/*.pem dist/",
    "build:tsc": "tsc -p .",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
